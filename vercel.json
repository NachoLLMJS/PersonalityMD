{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/imd/[...path].js": {
      "maxDuration": 30
    },
    "api/imd/orders/[id].js": {
      "maxDuration": 30
    },
    "api/imd/orders/[id]/submit.js": {
      "maxDuration": 30
    },
    "api/imd/workflows/[id].js": {
      "maxDuration": 30
    },
    "api/higgsfield/[...path].js": {
      "maxDuration": 60
    }
  }
}
